# demo never contacts the bank or 1C: orders are marked paid by a demo button instead of a real
# charge. An unset SHOP_MODE is live, so a forgotten variable cannot turn a real storefront into
# a demo. Keep this line for local preview and remove it (or set live) before shipping.
SHOP_MODE=demo
SHOP_URL=http://localhost:3000

# Use a local persistent disk. Leave empty for data/orders.sqlite; in the Docker image that is
# /app/data, which is exactly where the container's volume is mounted (see RELEASE.md, step 2b).
ORDERS_DB_PATH=
ORDERS_LEGACY_PATH=

# Admin login stays disabled until a secret of at least 16 characters is set.
ADMIN_PASSWORD=
# Optional comma-separated IP allowlist and Base32 TOTP secret for 2FA on /admin.
# A malformed or shorter-than-80-bit TOTP secret fails closed: login and existing sessions are denied.
ADMIN_ALLOW_IPS=
ADMIN_TOTP_SECRET=

# How long a piece stays off the storefront while its order is not paid: the reservation
# clock restarts on every change to the order, so confirming weights buys the buyer more
# time. A whole number of hours; 24 when unset.
RESERVATION_TTL_HOURS=

# Live catalog: GET returns Product[] or { products: Product[] }.
# Orders and payment status: POST to ONEC_API_URL/orders.
ONEC_API_URL=
ONEC_TOKEN=

# Live bank initialization and signed notifications.
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_TAXATION=
TBANK_VAT=

# Leave unapproved tariffs empty: the manager confirms them before payment.
DELIVERY_CDEK_RUB=
DELIVERY_YANDEX_RUB=
DELIVERY_DRIVEE_RUB=
FREE_DELIVERY_FROM=
