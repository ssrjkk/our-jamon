# demo never contacts the bank or 1C: orders are marked paid by a demo button instead of a real
# charge. An unset SHOP_MODE is live, so a forgotten variable cannot turn a real storefront into
# a demo. Keep this line for local preview and remove it (or set live) before shipping.
SHOP_MODE=demo
SHOP_URL=http://localhost:3000

# Use a local persistent disk. Leave empty for data/orders.sqlite.
ORDERS_DB_PATH=
ORDERS_LEGACY_PATH=

# Admin login stays disabled until a secret of at least 16 characters is set.
ADMIN_PASSWORD=

# Live catalog: GET returns Product[] or { products: Product[] }.
# Orders and payment status: POST to ONEC_API_URL/orders.
ONEC_API_URL=
ONEC_TOKEN=

# Live bank initialization and signed notifications.
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_TAXATION=
TBANK_VAT=

# Leave unapproved tariffs empty: the manager confirms them before payment.
DELIVERY_CDEK_RUB=
DELIVERY_YANDEX_RUB=
DELIVERY_DRIVEE_RUB=
FREE_DELIVERY_FROM=
